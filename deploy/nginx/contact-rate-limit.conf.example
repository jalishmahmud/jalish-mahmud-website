# Merge into EXISTING nginx configuration, not as a replacement server block.
# In http {} context, outside server {}:
limit_req_zone $binary_remote_addr zone=portfolio_contact:10m rate=3r/m;

# Inside the HTTPS server {} serving the portfolio:
location = /api/contact {
    limit_req zone=portfolio_contact burst=2 nodelay;
    limit_req_status 429;
    client_max_body_size 64k;
    client_body_timeout 10s;
    proxy_pass http://127.0.0.1:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 60s;
}
# Keep port 3000 private. For a CDN, configure real_ip with trusted provider
# ranges only. Never trust arbitrary forwarded IPs. Shared across nginx/PM2 workers.
